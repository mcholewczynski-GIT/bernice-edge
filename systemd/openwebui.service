[Unit]
Description=OpenWebUI — Bernice Knowledge Interface
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=cholewcm
WorkingDirectory=/opt/openwebui
EnvironmentFile=/home/ava/cholewcm/.env_secrets
ExecStart=/opt/openwebui/venv/bin/open-webui serve --host 0.0.0.0 --port 8888
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openwebui

[Install]
WantedBy=multi-user.target

